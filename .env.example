# Optional. Raises the GitHub API rate limit from 60 requests/hour (unauthenticated)
# to 5000/hour. Create a token with no scopes selected (public read access only)
# at https://github.com/settings/tokens.
GITHUB_TOKEN=

# Optional. Gates /api/mcp with a bearer token — set this before deploying
# somewhere the URL might leak (see docs/MCP_CLIENTS.md). Unset, the endpoint
# is open, which is fine for local dev but not a public deployment, since
# some tools mutate a World's state (submit_*, contribute_domain_concept,
# analyze_repository).
MCP_AUTH_TOKEN=

# Optional. Powers CodeBiome's own built-in demo agent (src/server/demo-agent/),
# used only so the web UI's "paste a URL" flow can populate a World without
# you connecting an external MCP client by hand. Unset, that flow still
# creates a World (with a real file tree) but leaves it for you to populate
# via your own connected agent instead (see docs/MCP_CLIENTS.md). Free at
# https://console.groq.com/keys — Groq's free tier is what makes this a
# no-cost default rather than requiring a funded API key.
GROQ_API_KEY=

# Optional. Overrides which Groq model the built-in demo agent uses —
# defaults to llama-3.3-70b-versatile if unset. See https://console.groq.com/docs/models.
DEMO_AGENT_MODEL=

# Production-only. Do NOT set these by hand — running `vercel storage create
# <name> --type blob --access private` then `vercel storage connect <name>
# --yes` provisions a Blob store and injects them automatically. As of the
# Vercel CLI's current default, `storage connect` uses OIDC auth: it sets
# BLOB_STORE_ID (and BLOB_WEBHOOK_PUBLIC_KEY) but NOT BLOB_READ_WRITE_TOKEN —
# the actual credential (VERCEL_OIDC_TOKEN) is injected per-request by the
# Vercel runtime and isn't visible via `vercel env ls`. Either var below
# (alone) is enough to select the durable Blob-backed World store
# (docs/WORLD_ARCHITECTURE.md) over the in-memory fallback. Leave both unset
# for local development — CodeBiome falls back to an in-memory World store
# automatically.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
